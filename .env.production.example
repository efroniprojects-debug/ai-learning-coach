# Production Environment Variables
# Copy to .env.production.local and fill in actual values

# Database
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/database

# Server
NODE_ENV=production
PORT=3001

# JWT
JWT_SECRET=[generate-random-32-char-string-openssl-rand-32]

# Google OAuth
GOOGLE_CLIENT_ID=[from-google-cloud-console]
GOOGLE_CLIENT_SECRET=[from-google-cloud-console]
GOOGLE_CALLBACK_URL=https://[railway-domain]/auth/google/callback

# Frontend
FRONTEND_URL=https://[vercel-domain]
ALLOWED_ORIGINS=https://[vercel-domain],https://www.yourdomain.com

# AI Providers (Choose at least one)
# Claude (Anthropic)
ANTHROPIC_API_KEY=[optional-if-users-provide]

# OpenAI
OPENAI_API_KEY=[optional-if-users-provide]

# Google Gemini
GEMINI_API_KEY=[optional-if-users-provide]

# Supabase (if using Supabase for storage)
SUPABASE_URL=https://[project].supabase.co
SUPABASE_KEY=[anon-key]

# Monitoring (optional)
SENTRY_DSN=[optional-for-error-tracking]

# Email (optional, for notifications)
SENDGRID_API_KEY=[optional-for-emails]
