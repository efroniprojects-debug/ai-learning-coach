{
  "name": "ai-learning-coach-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --loader tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node --loader tsx src/db/seed.ts"
  },
  "dependencies": {
    "fastify": "^4.25.0",
    "@fastify/jwt": "^7.8.0",
    "@fastify/cors": "^8.5.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0",
    "dotenv": "^16.3.0",
    "pg": "^8.11.0",
    "drizzle-orm": "^0.29.0",
    "crypto": "^1.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "jsonwebtoken": "^9.1.0",
    "bull": "^4.11.0",
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/passport-google-oauth20": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.0",
    "tsx": "^4.6.0",
    "drizzle-kit": "^0.20.0"
  }
}
