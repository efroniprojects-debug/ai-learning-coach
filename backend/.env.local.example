# Backend Environment Variables
# Copy this to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_learning_coach
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/ai_learning_coach_shadow

# Server
NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-for-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Encryption
ENCRYPTION_KEY=your-base64-encoded-32-byte-key
ENCRYPTION_ALGORITHM=aes-256-gcm

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Redis for job queue
REDIS_URL=redis://localhost:6379

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Debug logging
DEBUG=*
