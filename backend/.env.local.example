# Backend Environment Variables
# Copy this to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_learning_coach
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/ai_learning_coach_shadow

# Server
NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-for-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Google Drive learning-material sync (optional)
GOOGLE_DRIVE_FOLDER_ID=1h2UuAmDBveKi-XGYhsNMw1fe317pHZ9r
GOOGLE_DRIVE_STORAGE_FOLDER_ID=1Rxoj4LFuVqWNZoMUig4SQ31JRht2k53m
GOOGLE_DRIVE_EXAMS_ROOT_FOLDER_ID=1uSsFWQbN2pPtgayHpghQKSWKIcO1M32b
GOOGLE_DRIVE_PHYSICS_EXAMS_FOLDER_ID=1h2UuAmDBveKi-XGYhsNMw1fe317pHZ9r
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}

# Gemini demo tutor
DEMO_GEMINI_API_KEY=your-gemini-api-key

# Encryption
ENCRYPTION_KEY=your-base64-encoded-32-byte-key
ENCRYPTION_ALGORITHM=aes-256-gcm

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Redis for job queue
REDIS_URL=redis://localhost:6379

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Debug logging
DEBUG=*
