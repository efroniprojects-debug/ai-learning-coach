# Frontend Production Environment Variables
# Copy to .env.production and fill in actual values

# API Configuration
VITE_API_BASE_URL=https://[railway-domain]

# Google OAuth
VITE_GOOGLE_CLIENT_ID=[from-google-cloud-console]

# Frontend URL
VITE_FRONTEND_URL=https://[vercel-domain]

# Environment
VITE_ENV=production

# Optional: Analytics
VITE_GOOGLE_ANALYTICS_ID=[optional]
VITE_SENTRY_DSN=[optional-for-error-tracking]

# Optional: Feature Flags
VITE_ENABLE_FOCUS_MODE=true
VITE_ENABLE_COMMUNITY=false
VITE_MAX_FILE_SIZE_MB=50
