# Frontend Production Environment Variables
# These are set in Vercel Project Settings → Environment Variables
# Copy to .env.production for local testing and fill in actual values

# API Configuration (Backend URL)
VITE_API_BASE_URL=https://ai-learning-coach-production.up.railway.app

# Google OAuth (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=847962551048-fgsrhpqgl81dp69fk9es109llbjguk19.apps.googleusercontent.com

# Frontend URL
VITE_FRONTEND_URL=https://ai-learning-coach-ottxzkulk-sharon-efronis-projects.vercel.app

# Environment
VITE_ENV=production

# Optional: Analytics
VITE_GOOGLE_ANALYTICS_ID=[optional]
VITE_SENTRY_DSN=[optional-for-error-tracking]

# Optional: Feature Flags
VITE_ENABLE_FOCUS_MODE=true
VITE_ENABLE_COMMUNITY=false
VITE_MAX_FILE_SIZE_MB=50
