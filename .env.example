# Environment Variables Template
# Copy this to .env.local and fill in real values
# NEVER commit .env with real secrets

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/ai_learning_coach
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/ai_learning_coach_shadow

# ============================================================
# STORAGE (Google Cloud Storage)
# ============================================================
GCS_PROJECT_ID=your-gcp-project
GCS_BUCKET_NAME=ai-learning-coach-storage
GCS_KEY_FILE_PATH=./secrets/gcs-key.json
# Or use GOOGLE_APPLICATION_CREDENTIALS env var

# ============================================================
# REDIS (for job queue, caching)
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# GOOGLE OAUTH
# ============================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Production: https://yourdomain.com/api/auth/google/callback

# ============================================================
# JWT SECRETS (for signing auth tokens)
# ============================================================
JWT_SECRET=your-super-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# AI PROVIDER DEFAULT SETTINGS
# ============================================================
# Providers available: claude, gemini, openai
DEFAULT_AI_PROVIDER=claude
DEFAULT_AI_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# API KEY ENCRYPTION (for storing user's own API keys)
# ============================================================
# Used to encrypt/decrypt user-provided API keys in database
ENCRYPTION_KEY=your-aes-256-encryption-key-in-base64
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================
# AI PROVIDER API KEYS (for backend test/demo only)
# ============================================================
# These are optional. In production, users provide their own keys.
# Only use for development/testing.
# NEVER commit these to repo.

# Claude API Key (optional, for testing)
ANTHROPIC_API_KEY=sk-ant-...

# Gemini API Key (optional, for testing)
GEMINI_API_KEY=...

# OpenAI API Key (optional, for testing)
OPENAI_API_KEY=sk-proj-...

# ============================================================
# LOGGING & MONITORING
# ============================================================
LOG_LEVEL=debug
# Options: error, warn, info, debug, trace

SENTRY_DSN=https://...@sentry.io/...
# Error tracking (optional, for production)

# ============================================================
# FRONTEND
# ============================================================
VITE_API_URL=http://localhost:3001
# In production: https://api.yourdomain.com

VITE_GOOGLE_CLIENT_ID=same-as-backend-client-id

# ============================================================
# DEPLOYMENT & RUNTIME
# ============================================================
NODE_ENV=development
# Options: development, staging, production

PORT=3001
# Backend port (frontend usually on 3000)

# ============================================================
# FEATURE FLAGS (Future)
# ============================================================
FEATURE_MULTI_SUBJECT=false
FEATURE_TEACHER_DASHBOARD=false

# ============================================================
# SECURITY
# ============================================================
# CORS configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # per window per user

# ============================================================
# NOTEBOOKLM & MCP (for knowledge ingestion, dev only)
# ============================================================
NOTEBOOKLM_API_KEY=optional-for-development
